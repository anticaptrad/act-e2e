# Safe schema only. Real values belong in SOPS ciphertext under env/enc/.
YOUTUBE_GAS_URL=https://script.google.com/macros/s/REPLACE_WITH_DEPLOYMENT_ID/exec
YOUTUBE_GAS_API_KEY=replace-after-anticaptrad-account-restoration
YOUTUBE_GAS_EXPECTED_CHANNEL_HANDLE=@anticaptrad
YOUTUBE_GAS_EXPECTED_CHANNEL_ID=replace-with-pinned-youtube-channel-id

# Generated, ignored local artifacts.
YOUTUBE_E2E_VIDEO_PATH=tmp/youtube-lifecycle/anticaptrad-pg13-lifecycle-180s.mp4
YOUTUBE_E2E_METADATA_PATH=fixtures/youtube-lifecycle/metadata.json
YOUTUBE_E2E_RECEIPT_PATH=tmp/youtube-lifecycle/youtube-lifecycle-receipt.json
# Optional strict gate: point this at act-render's credential-free receipt.
YOUTUBE_E2E_RENDER_RECEIPT_PATH=
YOUTUBE_E2E_GAS_TIMEOUT_MS=300000
YOUTUBE_E2E_MAX_POLLS=12

# Public visibility is a separate, default-denied stage. Set these only for the
# reviewed video ID at the moment of publication; do not keep approval enabled.
YOUTUBE_E2E_ALLOW_PUBLIC=false
YOUTUBE_E2E_PUBLIC_APPROVAL=
