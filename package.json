{
  "name": "act-e2e",
  "version": "1.0.0",
  "description": "End-to-end interop tests for the AntiCapTrad services, exercised against the k8s cluster's Playwright, Puppeteer, and Selenium services plus the NATS bridge",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "node --test",
    "test:apps-script": "node --test \"tests/integration/apps-script.test.mjs\"",
    "test:playwright": "node --test \"tests/browser/playwright/*.test.mjs\"",
    "test:puppeteer": "node --test \"tests/browser/puppeteer/*.test.mjs\"",
    "test:selenium": "node --test \"tests/browser/selenium/*.test.mjs\"",
    "test:integration": "node --test \"tests/integration/*.test.mjs\"",
    "test:browser": "node --test \"tests/browser/**/*.test.mjs\"",
    "test:contracts": "node --test \"tests/contracts/*.test.mjs\"",
    "test:lifecycle": "node --test \"tests/lifecycle/*.test.mjs\"",
    "test:database": "node --test \"tests/database/*.test.mjs\"",
    "test:journeys": "node --test \"tests/journeys/*.test.mjs\"",
    "test:cluster": "node --test \"tests/cluster/*.test.mjs\"",
    "lint:ores": "if [ -f .ores-lint/lint.sh ]; then sh .ores-lint/lint.sh; else echo 'ores-lint not installed'; fi",
    "prepublishOnly": "npm run lint:ores"
  },
  "devDependencies": {
    "nats": "^2.28.2",
    "playwright-core": "^1.48.2",
    "puppeteer-core": "^23.6.0",
    "selenium-webdriver": "^4.26.0",
    "yaml": "^2.9.0"
  },
  "oresLint": {
    "note": "Declared, not installed. ores-lint resolves these from a global install - see .ores-lint/README.md",
    "requires": {
      "eslint": ">=9",
      "typescript-eslint": ">=8 (optional; without it .ts files are skipped)"
    },
    "install": "npm i -g eslint typescript-eslint"
  }
}
